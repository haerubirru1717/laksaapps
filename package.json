{
  "name": "laksaapps-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Laksa user app, admin panel, and Cloudflare Worker monorepo",
  "scripts": {
    "install:app": "npm --prefix app ci",
    "build:app": "npm --prefix app run build",
    "dev:app": "npm --prefix app run dev:frontend",
    "dev:admin": "npx http-server admin -p 5501",
    "dev:worker": "npm --prefix app run dev:worker",
    "deploy:worker": "npm --prefix app run deploy:worker"
  }
}
